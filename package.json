{
  "name": "@froooze/pi-plugins",
  "version": "0.1.0",
  "description": "Personal pi packages — extensions, skills, prompts, themes",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "type": "module",
  "pi": {
    "extensions": [
      "./extensions",
      "node_modules/@ff-labs/pi-fff/src/index.ts",
      "node_modules/@juicesharp/rpiv-btw/index.ts",
      "node_modules/@juicesharp/rpiv-todo/index.ts",
      "node_modules/pi-blackhole/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "dependencies": {
    "@ff-labs/pi-fff": "https://github.com/froooze/fff/archive/18ac372da0152c7c9a57ffc2613b0829621ee68e.tar.gz",
    "@juicesharp/rpiv-btw": "https://github.com/froooze/rpiv-mono/archive/6215d19d54d911776b3f9a714bc9f88c3623afb3.tar.gz",
    "@juicesharp/rpiv-todo": "https://github.com/froooze/rpiv-mono/archive/97dfbc54d92911d5ce8b25a72e63030301c49ff6.tar.gz",
    "pi-blackhole": "https://github.com/froooze/pi-blackhole/archive/0d1c5da8c346ce467102b078bd71fba997fd4222.tar.gz"
  },
  "scripts": {
    "test": "node --experimental-strip-types --no-warnings --test test/local-history.test.ts test/prompt-slim.test.ts test/compaction.test.ts test/opencode-zen.test.ts test/opencode-session-id.test.ts test/todo-reconcile.test.ts test/pins.test.ts",
    "test:pins": "node --experimental-strip-types --no-warnings --test test/pins.test.ts",
    "fork:split": "node scripts/fork-split.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "@sinclair/typebox": "*",
    "typebox": "*"
  },
  "allowScripts": {
    "@google/genai": true,
    "esbuild": true,
    "protobufjs": true,
    "pi-blackhole@0.5.5": true
  }
}
